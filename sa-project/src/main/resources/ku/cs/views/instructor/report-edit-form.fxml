                <Text layoutX="60.0" layoutY="430.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Result :">
                    <font><Font size="18.0" /></font>
                </Text>
                <ChoiceBox fx:id="resultChoiceBox" layoutX="310.0" layoutY="411.0" prefWidth="150.0" />

                <Text layoutX="60.0" layoutY="489.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Notes :">
                    <font><Font size="18.0" /></font>
                </Text>
                <TextArea fx:id="notesTextArea" layoutX="310.0" layoutY="469.0" prefHeight="115.0" prefWidth="436.0" />

                <Button layoutX="221.0" layoutY="613.0" mnemonicParsing="false" onAction="#handleReturnButtonAction" prefHeight="65.0" prefWidth="163.0" text="Return">
                    <font><Font size="30.0" /></font>
                </Button>

                <Button layoutX="675.0" layoutY="613.0" mnemonicParsing="false" onAction="#handleEditButtonAction" prefHeight="65.0" prefWidth="163.0" text="Edit">
                    <font><Font size="30.0" /></font>
