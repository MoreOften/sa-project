                        </Button>
                    </children>
                    <padding><Insets top="30.0" /></padding>
                </VBox>
            </center>
            <bottom>
                <VBox BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="logoutButton" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleLogoutButton" styleClass="sidebar-button" text="Log Out">
