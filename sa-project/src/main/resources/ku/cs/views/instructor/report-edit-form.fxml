<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@/ku/cs/views/style.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ku.cs.controllers.instructor.ReportEditFormController">

    <left>
        <BorderPane prefWidth="220.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <center>
                <VBox spacing="30.0" BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="homepageButton" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleHomepageButton" styleClass="sidebar-button" text="Homepage">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@/images/home-icon.png" /></image>
                                </ImageView>
                            </graphic>
                            <padding><Insets left="20.0" /></padding>
                        </Button>
                        <Button fx:id="scheduleButton" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleScheduleButton" styleClass="sidebar-button" text="Schedule">
