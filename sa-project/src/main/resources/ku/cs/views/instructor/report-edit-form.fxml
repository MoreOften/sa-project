                        </Button>
                    </children>
                    <padding><Insets bottom="10.0" /></padding>
                </VBox>
            </bottom>
        </BorderPane>
    </left>

    <center>
        <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Text layoutX="60.0" layoutY="113.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Edit Report" wrappingWidth="246.0">
                    <font><Font size="38.0" /></font>
                </Text>

                <Text layoutX="60.0" layoutY="187.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Report ID :" wrappingWidth="223.0">
                    <font><Font size="18.0" /></font>
                </Text>
                <Label fx:id="reportIdLabel" layoutX="310.0" layoutY="167.0" text="reportIdLabel">
                    <font><Font size="18.0" /></font>
                </Label>

                <Text layoutX="60.0" layoutY="242.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Supervisor Name :" wrappingWidth="163.0">
                    <font><Font size="18.0" /></font>
                </Text>
                <Label fx:id="supervisorNameLabel" layoutX="310.0" layoutY="222.0" text="supervisorNameLabel">
                    <font><Font size="18.0" /></font>
                </Label>

                <Text layoutX="60.0" layoutY="304.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Instructor Name :" wrappingWidth="163.0">
                    <font><Font size="18.0" /></font>
                </Text>
                <Label fx:id="instructorNameLabel" layoutX="310.0" layoutY="284.0" text="instructorNameLabel">
                    <font><Font size="18.0" /></font>
                </Label>

                <Text layoutX="60.0" layoutY="367.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Training Program :" wrappingWidth="232.0">
                    <font><Font size="18.0" /></font>
                </Text>
                <Label fx:id="trainingProgramLabel" layoutX="310.0" layoutY="347.0" text="trainingProgramLabel">
                    <font><Font size="18.0" /></font>
